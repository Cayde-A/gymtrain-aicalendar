# Copy this file to .env.local and configure Garmin access locally.
# .env.local is ignored by Git and should never be committed.

# Preferred read path. Create the key in Garmin Connect Web and store it in
# ~/.config/garmin/connect-personal-api-key with chmod 600. The key itself
# should not be copied into this tracked example file.
GARMIN_READ_PROVIDER=auto
GARMIN_PERSONAL_API_KEY_FILE=~/.config/garmin/connect-personal-api-key

# Compatibility write provider. Still required for workout upload/scheduling
# because Garmin Personal API access is pull-only.
GARMIN_EMAIL=your-email@example.com
GARMIN_PASSWORD=your-password

